<persistence-unit name="hibernate-postgresql">
  <description></description>
  <provider></provider>
  <exclude-unlisted-classes></exclude-unlisted-classes>
  <shared-cache-mode>NONE</shared-cache-mode>
  <properties>
    <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
    <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/pob" />
    <property name="jakarta.persistence.jdbc.user" value="pob" />
    <property name="jakarta.persistence.jdbc.password" value="pob" />

    <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
    <property name="hibernate.hbm2ddl.auto" value="update" />
    <property name="hibernate.generate_statistics" value="false" />
    <property name="hibernate.format_sql" value="false" />
    <property name="hibernate.show_sql" value="true" />
  </properties>
</persistence-unit>